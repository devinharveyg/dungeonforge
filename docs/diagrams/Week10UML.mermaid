---
title: DungeonForge Week 10 - UML grouped by Design Pattern (green = new or changed this week)
config:
  layout: elk
---
classDiagram
direction TB

%% ======================= DOMAIN CORE (not a pattern) =======================
namespace Domain_Core {
    class Entity {
        <<abstract>>
        #name
        #hp
        #maxHp
        #attackPower
        #defense
        +takeDamage(int)
        +heal(int)
        +isAlive() boolean
        +describe()* String
    }
    class Player {
        -gold
        -xp
        -inventory List~Item~
        -equippedWeapon Weapon
        +equip(Weapon) Weapon
        +lifesteal() int
        +findItem(String) Item
    }
    class Monster {
        -species
        -xpReward
        -strategy CombatStrategy
        -stateName MonsterState
        +setStrategy(CombatStrategy)
        +setState(MonsterState)
        +restoreState(MonsterState)
        +hpFraction() double
    }
    class Room {
        -id
        -flavor
        -monsters List~Monster~
        -floorItems List~Item~
        -chest Chest
        -exits Map~String, Room~
        +link(String, Room)
        +getExit(String) Room
    }
    class DungeonLevel {
        -depth
        -themeName
        -rooms List~Room~
    }
    class GameWorld {
        -levels List~DungeonLevel~
        -generators GeneratorRegistry
        -generate()
        -linkLevelsTogether()
        -populatorFor(ThemeKit, boolean) RoomPopulator
    }
    class Combat {
        +monsterTurns(Player, Room)
        +playerStrikes(Player, Monster)
        -monsterActs(Monster, Player, Room)
        +restAfterRoom(Player)$
    }
    class DungeonReport {
        <<diagnostic>>
        +of(GameWorld) String$
        +countOrphans(DungeonLevel) int$
        +stairsReachable(DungeonLevel) boolean$
        -reachableWithin(DungeonLevel) Set~Room~$
    }
    class Main {
        +main(String[])$
        -gameLoop()$
        -runScript()$
    }
}

%% ======================= ITEMS (plain) =======================
namespace Domain_Items {
    class Item {
        <<interface>>
        +getName() String
        +getWeight() double
        +getValue() int
        +describe() String
    }
    class Armor
    class Potion
    class Treasure
    class Hourglass {
        -charges
        +spendCharge()
    }
    class Chest {
        -contents List~Item~
    }
}

%% ======================= SINGLETON =======================
namespace Pattern_Singleton {
    class GameConfig {
        <<singleton>>
        -instance GameConfig$
        -settings Map
        -GameConfig()
        +getInstance() GameConfig$
        +getInt(String) int
        +getDouble(String) double
    }
    class RandomSource {
        <<singleton>>
        -instance RandomSource$
        -rng Random
        -RandomSource()
        +getInstance() RandomSource$
        +nextInt(int) int
        +reseed(long)
    }
}

%% ======================= SIMPLE FACTORY =======================
namespace Pattern_SimpleFactory {
    class MonsterFactory {
        <<simple factory>>
        -blueprints Map~String, MonsterDef~
        +create(String id, int depth) Monster
        +idsForTheme(String) List
        +strategyFor(String) CombatStrategy$
    }
    class MonsterDef {
        +id
        +name
        +hp
        +attack
        +xp
        +theme
        +boss
        +strategy
    }
}

%% ======================= ABSTRACT FACTORY =======================
namespace Pattern_AbstractFactory {
    class ThemeKit {
        <<interface>>
        +themeName() String
        +createMonster(int) Monster
        +createBoss(int) Monster
        +createLoot(int) Item
        +createRoomFlavor() String
    }
    class CryptThemeKit
    class ForgeThemeKit
    class FrostThemeKit
    class WinterfellThemeKit
    class ThemeRegistry {
        -kits List~ThemeKit~
        +forDepth(int) ThemeKit
    }
}

%% ======================= FACTORY METHOD + TEMPLATE METHOD (rooms) =======================
namespace Pattern_FactoryMethod {
    class RoomPopulator {
        <<abstract>>
        #theme ThemeKit
        +populate(Room, int) final
        #createEncounter(int)* List~Monster~
        #createChest(int) Chest
        +kind()* String
    }
    class StandardRoomPopulator
    class TreasureRoomPopulator
    class BossRoomPopulator
}

%% ======================= TEMPLATE METHOD (level generation) - NEW WEEK 10 =======================
namespace Pattern_TemplateMethod_LevelGen {
    class LevelGenerator {
        <<abstract template>>
        #DIRECTIONS String[]$
        +generate(int, ThemeKit, int, boolean) DungeonLevel final
        #connectRooms(DungeonLevel)* void
        +shapeName()* String
        #addShortcuts(DungeonLevel) hook
        #decorate(DungeonLevel, ThemeKit) hook
        -createRooms()
        -markEntrance()
        -populateRooms()
        -enforceReachability()
        #connect(Room, String, Room)$
        #tryConnect(Room, String, Room) boolean
        #opposite(String)$ String
    }
    class CorridorGenerator {
        #connectRooms(DungeonLevel)* void
    }
    class CaveGenerator {
        #connectRooms(DungeonLevel)* void
        -attachToSomeEarlierRoom()
        #addShortcuts(DungeonLevel)
    }
    class RingGenerator {
        #connectRooms(DungeonLevel)* void
    }
    class SpokeGenerator {
        #connectRooms(DungeonLevel)* void
    }
    class GeneratorRegistry {
        -shapes List~LevelGenerator~
        +forDepth(int) LevelGenerator
        +shapeNames() List~String~
    }
}

%% ======================= STRATEGY =======================
namespace Pattern_Strategy {
    class CombatStrategy {
        <<interface>>
        +chooseAction(Monster, Player, Room) Action
        +name() String
    }
    class AggressiveStrategy
    class SkittishStrategy
    class RangedStrategy
    class HealerStrategy
    class RedCoatStrategy
    class Action {
        +Type ATTACK/RANGED_ATTACK/FLEE/HEAL_ALLY/WAIT
        -target Entity
        -flavor String
    }
}

%% ======================= STATE (monster lifecycle) =======================
namespace Pattern_State_Monster {
    class MonsterState {
        <<interface>>
        +onEnter(Monster)
        +canAct() boolean
        +damageMultiplier() double
        +next(Monster, Player) MonsterState
        +label() String
    }
    class IdleState
    class HuntingState
    class EnragedState
    class FleeingState
    class DeadState
}

%% ======================= STATE (game mode) =======================
namespace Pattern_State_Game {
    class GameState {
        <<interface>>
        +onEnter(GameContext)
        +onExit(GameContext)
        +availableCommands() List~String~
        +isTerminal() boolean
    }
    class ExploringState
    class CombatState
    class InventoryState
    class GameOverState
}

%% ======================= OBSERVER =======================
namespace Pattern_Observer {
    class EventBus {
        <<subject>>
        -listeners List
        +subscribe(GameEventListener)
        +unsubscribe(GameEventListener)
        +publish(GameEvent)
        +message(String)
    }
    class GameEventListener {
        <<interface>>
        +onEvent(GameEvent)
    }
    class GameEvent {
        -type EventType
        -payload Map
    }
    class EventType {
        <<enumeration>>
        DAMAGE_DEALT
        DAMAGE_TAKEN
        MONSTER_DIED
        MONSTER_FLED
        STRATEGY_CHANGED
        ROOM_CLEARED
        MESSAGE
        etc
    }
    class QuestTracker
    class AchievementSystem
    class CombatLog
    class DamageMeter
    class ConsolePrinter {
        Main inner class
    }
    class Quest
}

%% ======================= COMMAND (+ Null Object, Macro, Memento) =======================
namespace Pattern_Command {
    class Command {
        <<interface>>
        +execute()
        +undo()
        +getDescription() String
        +isUndoable() boolean
        +endsTurn() boolean
    }
    class AbstractCommand {
        <<abstract>>
        #ctx GameContext
        #args String
        +execute() final
        #doExecute()* boolean
        +undo()
    }
    class MoveCommand {
        north south east west down
    }
    class AttackCommand
    class TakeCommand
    class DropCommand
    class UseItemCommand
    class EquipCommand
    class EnchantCommand
    class DisenchantCommand
    class SimpleCommand {
        read-only commands
    }
    class MacroCommand {
        <<composite macro>>
        -children List~Command~
    }
    class NoCommand {
        <<null object>>
    }
    class CommandFactory {
        <<functional interface>>
        +create(GameContext, String) Command
    }
    class CommandParser {
        <<invoker>>
        -registry Map
        -aliases Map
        +parse(String, GameContext) Command
    }
    class CommandHistory {
        -undoStack Deque~Command~
        -replayLog List~String~
        +push(Command)
        +undoLast() boolean
    }
    class GameContext {
        <<receiver and state context>>
        -state GameState
        -currentRoom Room
        +transitionTo(GameState)
        +syncState()
    }
    class TurnSnapshot {
        <<memento>>
        +capture(Player, Room)$ TurnSnapshot
        +restore()
    }
}

%% ======================= DECORATOR =======================
namespace Pattern_Decorator {
    class Weapon {
        <<interface>>
        +getDamage() int
        +lifesteal() int
        +peel() Weapon
    }
    class BasicWeapon {
        <<concrete component>>
    }
    class WeaponDecorator {
        <<abstract decorator>>
        #wrapped Weapon
        #prefix()* String
        #valueBonus()* int
        +peel() Weapon
    }
    class FlamingWeapon
    class FrostWeapon
    class VampiricWeapon
    class KeenWeapon
    class EnchantmentRegistry {
        -SPELLS Map~String, UnaryOperator~
        +apply(String, Weapon) Weapon$
    }
}

%% =============================================================
%% RELATIONSHIPS
%% =============================================================

%% --- Domain ---
Entity <|-- Player
Entity <|-- Monster
DungeonLevel "1" *-- "many" Room
GameWorld "1" *-- "many" DungeonLevel
Room "1" o-- "many" Monster
Room o-- Chest
Room o-- Item
Player o-- Item
Chest o-- Item
Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure
Item <|.. Hourglass
Main ..> GameContext
Main ..> CommandParser
Main ..> DungeonReport : --report flag
GameWorld ..> MonsterFactory
GameWorld ..> ThemeRegistry
Combat ..> EventBus
DungeonReport ..> GameWorld : inspects
DungeonReport ..> DungeonLevel : inspects

%% --- Singleton ---
MonsterFactory ..> GameConfig : reads
CryptThemeKit ..> RandomSource
RandomSource ..> GameConfig : seed
Player ..> GameConfig
RangedStrategy ..> RandomSource
RedCoatStrategy ..> RandomSource
LevelGenerator ..> RandomSource : rng()
LevelGenerator ..> GameConfig

%% --- Simple Factory ---
MonsterFactory o-- MonsterDef
MonsterFactory ..> Monster : creates
MonsterFactory ..> CombatStrategy : strategyFor

%% --- Abstract Factory ---
ThemeKit <|.. CryptThemeKit
ThemeKit <|.. ForgeThemeKit
ThemeKit <|.. FrostThemeKit
ThemeKit <|.. WinterfellThemeKit
ThemeRegistry o-- ThemeKit
ThemeKit ..> Monster : makes
ThemeKit ..> Item : makes
CryptThemeKit --> MonsterFactory
ForgeThemeKit --> MonsterFactory
FrostThemeKit --> MonsterFactory
WinterfellThemeKit --> MonsterFactory

%% --- Factory Method / Template Method (rooms) ---
RoomPopulator <|-- StandardRoomPopulator
RoomPopulator <|-- TreasureRoomPopulator
RoomPopulator <|-- BossRoomPopulator
RoomPopulator --> ThemeKit : theme
RoomPopulator ..> Room : populate

%% --- Template Method (level generation, NEW) ---
LevelGenerator <|-- CorridorGenerator
LevelGenerator <|-- CaveGenerator
LevelGenerator <|-- RingGenerator
LevelGenerator <|-- SpokeGenerator
GeneratorRegistry o-- LevelGenerator
GameWorld --> GeneratorRegistry
GameWorld ..> LevelGenerator : generate()
LevelGenerator ..> DungeonLevel : builds
LevelGenerator ..> Room : creates and links
LevelGenerator ..> ThemeKit : theme
LevelGenerator ..> RoomPopulator : picks subclass and populates

%% --- Strategy ---
Monster o-- CombatStrategy : HAS-A
CombatStrategy <|.. AggressiveStrategy
CombatStrategy <|.. SkittishStrategy
CombatStrategy <|.. RangedStrategy
CombatStrategy <|.. HealerStrategy
CombatStrategy <|.. RedCoatStrategy
CombatStrategy ..> Action : returns
Combat ..> CombatStrategy : asks
Combat ..> Action : performs

%% --- State: monster ---
Monster o-- MonsterState : HAS-A
MonsterState <|.. IdleState
MonsterState <|.. HuntingState
MonsterState <|.. EnragedState
MonsterState <|.. FleeingState
MonsterState <|.. DeadState
IdleState ..> HuntingState : next
HuntingState ..> EnragedState : next
HuntingState ..> FleeingState : next
EnragedState ..> FleeingState : next
EnragedState ..> AggressiveStrategy : onEnter swaps
FleeingState ..> SkittishStrategy : onEnter swaps
Combat ..> MonsterState : next()

%% --- State: game mode ---
GameContext o-- GameState : current
GameState <|.. ExploringState
GameState <|.. CombatState
GameState <|.. InventoryState
GameState <|.. GameOverState

%% --- Observer ---
EventBus o-- GameEventListener : many
GameEventListener <|.. QuestTracker
GameEventListener <|.. AchievementSystem
GameEventListener <|.. CombatLog
GameEventListener <|.. DamageMeter
GameEventListener <|.. ConsolePrinter
EventBus ..> GameEvent : publishes
GameEvent --> EventType
QuestTracker o-- Quest
Combat ..> EventBus : publishes
GameContext --> EventBus

%% --- Command ---
Command <|.. AbstractCommand
Command <|.. SimpleCommand
Command <|.. MacroCommand
Command <|.. NoCommand
AbstractCommand <|-- MoveCommand
AbstractCommand <|-- AttackCommand
AbstractCommand <|-- TakeCommand
AbstractCommand <|-- DropCommand
AbstractCommand <|-- UseItemCommand
AbstractCommand <|-- EquipCommand
AbstractCommand <|-- EnchantCommand
AbstractCommand <|-- DisenchantCommand
MacroCommand o-- Command : children
CommandParser o-- CommandFactory : registry
CommandParser ..> Command : parse returns
CommandHistory o-- Command : undo stack
AbstractCommand --> GameContext : receiver
AbstractCommand ..> TurnSnapshot : captures before-state
GameContext --> CommandHistory
GameContext --> Combat
GameContext --> GameWorld
UseItemCommand ..> CommandHistory : hourglass undoLast
UseItemCommand ..> Hourglass
CommandParser ..> MacroCommand : loot macro

%% --- Memento ---
TurnSnapshot ..> Player : saves and restores
TurnSnapshot ..> Room : saves and restores
TurnSnapshot ..> Monster : saves and restores

%% --- Decorator ---
Item <|-- Weapon
Weapon <|.. BasicWeapon
Weapon <|.. WeaponDecorator
WeaponDecorator o-- Weapon : wraps
WeaponDecorator <|-- FlamingWeapon
WeaponDecorator <|-- FrostWeapon
WeaponDecorator <|-- VampiricWeapon
WeaponDecorator <|-- KeenWeapon
EnchantmentRegistry ..> WeaponDecorator : builds
EnchantCommand ..> EnchantmentRegistry
DisenchantCommand ..> Weapon : peel()
Player o-- Weapon : equipped

%% =============================================================
%% HIGHLIGHT: new or changed this week
%% =============================================================
classDef changed fill:#d9f2d9,stroke:#2e7d32,stroke-width:2px,color:#000
cssClass "LevelGenerator,CorridorGenerator,CaveGenerator,RingGenerator,SpokeGenerator,GeneratorRegistry,DungeonReport,DisenchantCommand,GameWorld,Weapon,WeaponDecorator,MoveCommand,CommandParser,ExploringState,Main" changed

%% =============================================================
%% NOTES (things worth a second look)
%% =============================================================
note for LevelGenerator "generate() is the template: createRooms, connectRooms, markEntrance, populateRooms, addShortcuts, decorate, enforceReachability. Subclasses only supply the shape. BUG: opposite() has a typo 'ease', so east falls through to default south."
note for GameWorld "Dead code left behind: private populatorFor() is now unused, because LevelGenerator has its own copy."
note for WeaponDecorator "peel() replaced unwrap(). Missing closing paren in describe()."
note for DamageMeter "Never subscribed in Main"
note for RedCoatStrategy "Not registered in MonsterFactory.strategyFor()"
